{
  "name": "conduit",
  "version": "0.1.0",
  "description": "OpenAI-compatible endpoint backed by agent subscriptions (Claude Code via the Agent SDK)",
  "license": "MIT",
  "bin": {
    "conduit": "./bin/conduit.js"
  },
  "type": "module",
  "scripts": {
    "dev": "node src/cli.ts serve",
    "capture": "node src/cli.ts capture",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
